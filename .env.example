APP_NAME=Quiz System
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

APP_TIMEZONE=Asia/Ho_Chi_Minh

# Quiz Configuration
QUIZ_REGISTRATION_ENABLED=true
QUIZ_EMAIL_VERIFICATION=true
QUIZ_OPEN_QUIZ=false
QUIZ_WEBCAM_MONITORING=true
QUIZ_GOOGLE_CHARTS=true
QUIZ_MASTER_PASSWORD=Admin@123456
QUIZ_DEFAULT_GROUP=1
QUIZ_BASE_CURRENCY=VND
QUIZ_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
QUIZ_DEFAULT_LANGUAGE=vi

# Payment Gateways
VNPAY_TMNCODE=
VNPAY_HASHSECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paygate

MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

2CHECKOUT_MERCHANT_CODE=
2CHECKOUT_MERCHANT_KEY=
2CHECKOUT_API_URL=https://sandbox.2checkout.com

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=
FIREBASE_TOKEN_URI=

# AI Services
GEMINI_API_KEY=
AI_PROVIDER=gemini

# WordPress Integration (Optional)
WORDPRESS_SITE_URL=
WORDPRESS_API_KEY=

# Android App
ANDROID_API_ENABLED=true
ANDROID_APP_SECRET=

# Email Configuration
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_ADDRESS="noreply@quizsystem.com"
MAIL_FROM_NAME="${APP_NAME}"

# Email specific settings
MAIL_ACTIVATION_TEMPLATE=activation
MAIL_PASSWORD_RESET_TEMPLATE=password_reset
MAIL_RESULT_TEMPLATE=quiz_result

# Database
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcasting
BROADCAST_CONNECTION=log
BROADCAST_DRIVER=log

# Filesystem
FILESYSTEM_DISK=local
FILESYSTEM_VISIBILITY=private

# Queue
QUEUE_CONNECTION=database

# Cache
CACHE_STORE=database
# CACHE_PREFIX=

# Memcached
MEMCACHED_HOST=127.0.0.1

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# AWS (For S3 file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Security
BCRYPT_ROUNDS=12
HASH_DRIVER=bcrypt

# API rate limiting
API_RATE_LIMIT=60
API_RATE_LIMIT_PERIOD=1

# File upload
FILE_MAX_SIZE=10240
FILE_ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx,xls,xlsx

# Vite
VITE_APP_NAME="${APP_NAME}"
